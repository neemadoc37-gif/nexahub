modules = ["web", "python-base-3.12", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "basket"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --frozen --no-sync gunicorn --config gunicorn.conf.py production:application"
waitForPort = 5000

[[workflows.workflow]]
name = "basket"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:basket"

[workflows.workflow.metadata]
isValidation = true



[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 30000

[[ports]]
localPort = 5000
externalPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "--frozen", "--no-sync", "gunicorn", "--config", "gunicorn.conf.py", "production:application"]
build = ["uv", "sync", "--frozen", "--no-dev"]
